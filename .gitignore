# Node
node_modules/
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Build output for the bundled MCP server
plugin/mcp/model-dispatch/dist/

# Run outputs. Greenfield/brownfield runs write to ./src and ./.sdlc in
# whatever directory they were started from.
/src/
/.sdlc/
examples/*/passes/*/

# Per-run agy customization roots that run.mjs materialises with secrets
# inlined when ${VAR} interpolation is unavailable (p1-agy-runtime.md check 5).
.agents/run-*/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Hook heartbeat log written next to the workspace by plugin/agy/hooks/heartbeat.mjs
.hook-logs/

# A stray clone of this repo nested in the working tree; never part of the harness
/ai-sdlc-orchestrator-antigravity-harness/

# Clones agy makes of the workspace inside itself during an interactive session (seen 2026-09-17 as ./Untitled/)
/Untitled/

# Python, only on machines that opted into the Antigravity SDK agent path
__pycache__/
plugin/mcp/model-dispatch/worker/.venv/
