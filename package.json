{
  "name": "ai-sdlc-orchestrator-antigravity-harness",
  "version": "0.1.0",
  "description": "Antigravity CLI harness that runs a multi-model AI-SDLC pipeline against a project brief and reports what the run spent.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "node tools/setup.mjs",
    "build": "npm --prefix plugin/mcp/model-dispatch ci && npm --prefix plugin/mcp/model-dispatch run build",
    "verify": "node plugin/agy/verify-setup.mjs",
    "run": "node plugin/agy/run.mjs",
    "report": "node tools/report.mjs",
    "test": "node --test tools/test/*.test.mjs && node tools/test-mcp.mjs",
    "smoke": "node plugin/agy/run.mjs --gates=auto-approve --policy=antigravity-flash38-plus-opus5 --agy-bin=tools/test/fixtures/fake-agy/agy",
    "console": "node plugin/policy-console/policy-server.mjs --port 3000"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tl-ai-labs/ai-sdlc-orchestrator-antigravity-harness.git"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  }
}
